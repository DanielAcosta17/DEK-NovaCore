rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Businesses collection:
    // Anyone can read active businesses for public storefronts (/negocio/{slug})
    // Only authenticated owners or admins can write/update/delete
    match /businesses/{businessId} {
      allow read: if resource.data.isActive == true || isSignedIn();
      allow create: if isSignedIn() && request.resource.data.name is string && request.resource.data.slug is string;
      allow update, delete: if isSignedIn();

      // Subcollection: Categories
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Subcollection: Products
      match /products/{productId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Subcollection: Orders
      // Public visitors can place an order/inquiry document
      // Only authenticated business managers can read or manage orders
      match /orders/{orderId} {
        allow create: if request.resource.data.totalAmount is number && request.resource.data.items is list;
        allow read, update, delete: if isSignedIn();
      }
    }

    // Users profile collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
